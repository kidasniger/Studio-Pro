<resources>
    <style name="Theme.StudioPro" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_obsidian</item>
        <item name="android:statusBarColor">@color/bg_obsidian</item>
        <item name="android:navigationBarColor">@color/bg_obsidian</item>
    </style>

    <!-- Thème SplashScreen Android 12+ (androidx.core.splashscreen) -->
    <style name="Theme.StudioPro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">850</item>
        <item name="postSplashScreenTheme">@style/Theme.StudioPro</item>
    </style>
</resources>
